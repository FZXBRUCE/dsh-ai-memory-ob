{
  "name": "dsh-ai-memory-ob",
  "version": "0.4.1",
  "private": true,
  "description": "DSH 长期记忆库：每次对话生成用户画像与 Obsidian 格式的记忆库（双链 + 图谱），/load 读取注入、/write 归档、/update 连图谱、/zip 压缩、/new 重建。",
  "icon": "icon.svg",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FZXBRUCE/dsh-ai-memory-ob.git"
  },
  "homepage": "https://github.com/FZXBRUCE/dsh-ai-memory-ob",
  "bugs": {
    "url": "https://github.com/FZXBRUCE/dsh-ai-memory-ob/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "memory",
    "knowledge-graph"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/util.js",
    "lib/entry.js",
    "lib/profile.js",
    "lib/vault.js",
    "lib/digest.js",
    "lib/settings.js",
    "lib/summarize.js",
    "lib/service.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
